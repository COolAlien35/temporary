# Local development only. Compose supplies container hostnames separately.
QL_ENVIRONMENT=development
QL_DATABASE_URL=postgresql+psycopg://quantumloop:quantumloop@localhost:5432/quantumloop
QL_BROKER_URL=redis://localhost:6379/0
QL_CACHE_URL=redis://localhost:6380/0
QL_RESULT_BACKEND=redis://localhost:6380/1
# Configure Supabase asymmetric signing keys for authenticated API routes.
# QL_AUTH_ISSUER=https://YOUR_PROJECT.supabase.co/auth/v1
QL_AUTH_AUDIENCE=authenticated
QL_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
QL_DB_POOL_SIZE=5
QL_DB_MAX_OVERFLOW=5
QL_WORKER_DB_POOL_SIZE=2
QL_WORKER_DB_MAX_OVERFLOW=0
QL_TASK_SOFT_TIME_LIMIT=240
QL_TASK_TIME_LIMIT=300
QL_BROKER_VISIBILITY_TIMEOUT=600
# Tutor provider stays inactive without a server-side API key.
# QL_TUTOR_API_KEY=your-server-only-openai-key
QL_TUTOR_BASE_URL=https://api.openai.com/v1
QL_TUTOR_MODEL=gpt-5.4-mini
QL_TUTOR_TIMEOUT_SECONDS=15
QL_TUTOR_MAX_COMPLETION_TOKENS=256
QL_TUTOR_DAILY_REQUEST_LIMIT=20
# Independent embedding provider configuration (1536 is fixed by migration 0006).
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536
# EMBEDDING_API_KEY=your-openai-api-key
EMBEDDING_BASE_URL=https://api.openai.com/v1
# The local identity/cohort APIs are enabled when QL_AUTH_ISSUER is configured.
# Add server-only storage, qBraid, Piston, and tutor credentials with their modules.
# Provider choices and deployment boundaries: ../docs/provider-decisions.md
